# Settings shared by every machine. Git reads ~/.gitconfig after this file: it holds this
# machine's identities, accounts and hosts, and is never tracked. docs/git-identities.md
# explains the layers.

[user]
	# No identity by default: outside a folder that sets one, git refuses to commit.
	useConfigOnly = true

[credential]
	# Fail instead of asking for a username or password.
	interactive = false
# Only an identity may supply GitHub credentials: drop Homebrew's keychain helper here.
[credential "https://github.com"]
	helper =
[credential "https://gist.github.com"]
	helper =

[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	# Catppuccin Mocha, the whole mocha block of its official port: github.com/catppuccin/delta
	syntax-theme = Catppuccin Mocha
	dark = true
	blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
	commit-decoration-style = "#6c7086" bold box ul
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6c7086"
	line-numbers-minus-style = bold "#f38ba8"
	line-numbers-plus-style = bold "#a6e3a1"
	line-numbers-right-style = "#6c7086"
	line-numbers-zero-style = "#6c7086"
	minus-style = syntax "#493447"
	minus-emph-style = bold syntax "#694559"
	plus-style = syntax "#394545"
	plus-emph-style = bold syntax "#4e6356"
	# Moved code (diff.colorMoved) in Catppuccin instead of raw terminal colors.
	map-styles = bold purple => syntax "#5b4e74", bold blue => syntax "#445375", bold cyan => syntax "#446170", bold yellow => syntax "#6b635b"
[pager]
	branch = false

[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
